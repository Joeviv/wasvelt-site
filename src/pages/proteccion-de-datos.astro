    <section class="legal-content">

      <h2>1. Quiénes somos y cómo contactarnos</h2>
      <div class="table-scroll">
        <table class="kv">
          <tbody>
            <tr><th>Responsable del tratamiento</th><td>INDUSTRIAS WASVELT S.A.S.</td></tr>
            <tr><th>NIT</th><td>800.166.064-6</td></tr>
            <tr><th>Domicilio</th><td>Mosquera, Cundinamarca, Colombia</td></tr>
            <tr><th>Dirección</th><td>Carrera 13A No. 10-52</td></tr>
            <tr><th>Correo para protección de datos</th><td><a href="mailto:protecciondedatos@wasvelt.com">protecciondedatos@wasvelt.com</a></td></tr>
            <tr><th>Teléfono</th><td>8932354</td></tr>
            <tr><th>Sitio web</th><td>www.wasvelt.com</td></tr>
            <tr><th>Área responsable</th><td>Talento Humano</td></tr>
