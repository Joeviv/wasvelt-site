---
// Página propia para las rutas que no existen. Astro la emite como `dist/404.html`;
// Amplify la sirve con estado 404 cuando su regla `/<*>` apunta a `/404.html`.
// Antes se servía la portada con estado 404.
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Página no encontrada | Industrias Wasvelt"
  description="La página que busca no existe o cambió de dirección."
  robots="noindex, follow"
>
  <div class="container">
    <header class="page-header">
      <h1>PÁGINA NO ENCONTRADA</h1>
    </header>
    <section class="contenido">
      <p>La página que busca no existe o cambió de dirección.</p>
      <ul class="enlaces">
        <li><a href="/">Inicio</a></li>
        <li><a href="/productos">Productos</a></li>
        <li><a href="/contacto">Contacto</a></li>
      </ul>
    </section>
  </div>
</Layout>

<style>
  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 4rem 2rem;
    text-align: center;
  }

  .page-header {
    margin-bottom: 2rem;
  }

  .page-header h1 {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-weight: 200;
    font-size: 2.8rem;
    color: #888;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .contenido p {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }

  .enlaces {
    list-style: none;
    padding: 0;
    display: flex;
    justify-content: center;
    gap: 2rem;
  }

  .enlaces a {
    color: var(--color-primary);
  }

  @media (max-width: 600px) {
    .container { padding: 2rem 1rem; }
    .page-header h1 { font-size: 2rem; }
  }
</style>
